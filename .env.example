# .env.example — ESTE arquivo vai para o Git.
# Copie para .env e preencha os valores:  cp .env.example .env

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Desenvolvimento (settings/dev.py). Em produção, defina estes no Render.
# Domínios separados por vírgula, sem espaço
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Apenas em produção (settings/prod.py), configurado no Render:
# DJANGO_SETTINGS_MODULE=fic.settings.prod
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Caminho do admin (troque em produção)
ADMIN_URL=admin/